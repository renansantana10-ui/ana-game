[node name="Body" type="Label" parent="Root/Margin/Panel/Padding/Lines"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "WASD — Movimentar
Shift — Correr
Mouse — Girar câmera
Espaço — Pular
Esc — Liberar mouse
Clique — Retomar câmera"

[node name="VehiclePanel" type="PanelContainer" parent="Root/Margin"]
